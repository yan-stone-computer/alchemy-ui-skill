{
  "$schema": "https://ui-alchemy.dev/schemas/design-tokens.json",
  "meta": {
    "project": "Replace with project name",
    "direction": "One-sentence feel: who is the human, what must they do, how should it feel",
    "mode": "persuade | operate | read | experience",
    "signature": "The one element that could only exist for this product"
  },
  "color": {
    "surface": "#F7F5F2",
    "surfaceElevated": "#FEFDFB",
    "surfaceInset": "#EFEDE9",
    "foreground": "#1C1917",
    "foregroundSecondary": "#57534E",
    "foregroundMuted": "#78716C",
    "border": "rgba(28, 25, 23, 0.10)",
    "borderStrong": "rgba(28, 25, 23, 0.18)",
    "brand": "#B45309",
    "brandForeground": "#FEFDFB",
    "success": "#15803D",
    "warning": "#B45309",
    "destructive": "#B91C1C",
    "dark": {
      "surface": "#141211",
      "surfaceElevated": "#1C1A18",
      "surfaceInset": "#0E0D0C",
      "foreground": "#F5F5F4",
      "foregroundSecondary": "#D6D3D1",
      "foregroundMuted": "#A8A29E",
      "border": "rgba(255, 255, 255, 0.08)",
      "borderStrong": "rgba(255, 255, 255, 0.14)"
    }
  },
  "typography": {
    "display": "Replace with a characterful display face, self-hosted",
    "body": "Replace with a complementary body face",
    "utility": "Replace with a utility face for captions/data",
    "scaleRatio": 1.25,
    "baseSize": 16,
    "bodyMeasureCh": 70
  },
  "spacing": {
    "baseUnit": 4,
    "scale": [4, 8, 12, 16, 20, 24, 32, 48, 64, 96, 128]
  },
  "radius": {
    "control": 6,
    "card": 12,
    "modal": 16,
    "pill": 999
  },
  "depth": "borders | subtle-shadows | layered-shadows | surface-shifts (pick ONE)",
  "elevation": {
    "level0": "base",
    "level1": "+7% lightness (dark) or soft ring + shadow (light)",
    "level2": "+9% lightness",
    "level3": "+12% lightness or layered shadow"
  },
  "motion": {
    "durationFastMs": 120,
    "durationBaseMs": 200,
    "durationSlowMs": 300,
    "enterEasing": "cubic-bezier(0.23, 1, 0.32, 1)",
    "reducedMotion": "useReducedMotion() / prefers-reduced-motion gate"
  },
  "zIndexScale": {
    "sticky": 10,
    "modal": 40,
    "overlay": 50,
    "toast": 60
  }
}
